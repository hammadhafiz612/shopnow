<div class="form-columns"><div><label for="product-name">Product name *</label><input id="product-name" name="name" maxlength="150" required value="<%= values.name || '' %>"></div><div><label for="product-sku">SKU *</label><input id="product-sku" name="sku" maxlength="60" required value="<%= values.sku || '' %>"><p class="field-hint">A unique product code, for example SHOP-ELE-026.</p></div></div>
<div><label for="product-category">Category *</label><select id="product-category" name="category_id" required><option value="">Choose a category</option><% categories.forEach(category => { %><option value="<%= category.id %>"<% if (String(values.category_id) === String(category.id)) { %> selected<% } %>><%= category.name %><%= category.is_active ? '' : ' (Inactive)' %></option><% }); %></select><p class="field-hint">An active product needs an active category.</p></div>
<div><label for="product-description">Description *</label><textarea id="product-description" name="description" rows="6" maxlength="5000" required><%= values.description || '' %></textarea></div>
<div class="form-columns"><div><label for="product-price">Price (PKR) *</label><input id="product-price" name="price" type="number" min="0" max="9999999999.99" step="0.01" required value="<%= values.price || '0.00' %>"></div><% if (!recordId) { %><div><label for="initial-stock">Initial stock *</label><input id="initial-stock" name="stock_quantity" type="number" min="0" max="2147483647" step="1" required value="<%= values.stock_quantity === undefined ? 0 : values.stock_quantity %>"></div><% } %></div>
<% if (recordId) { %><div class="admin-info-note">Change stock on the <a href="/admin/inventory?q=<%= encodeURIComponent(values.sku || '') %>">Inventory page</a>. Saving product details keeps the current stock quantity.</div><% } %>
<% if (recordId) { %><p class="field-hint"><a class="text-link" href="/admin/products/<%= recordId %>/images">Manage product images &rarr;</a></p><% } else { %><p class="field-hint">Save this product first, then open Manage product images to add photos.</p><% } %>
