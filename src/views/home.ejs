<%- include("partials/header") %>

<main id="main-content" class="container home-page">
  <section class="row align-items-center g-5 hero" aria-labelledby="home-title">
    <div class="col-lg-7">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Good finds for your everyday</p>
      <h1 id="home-title">Your next favourite find starts here.</h1>
      <p class="hero-copy">From your work desk to your weekend plans. Explore <%= totalProducts %> products and find something that fits your day.</p>
      <a class="shop-button" href="/products">Explore products <span aria-hidden="true">&rarr;</span></a>
      <form class="home-search" action="/products" method="get" role="search">
        <label for="home-search" class="visually-hidden">Search products</label>
        <input id="home-search" type="search" name="q" maxlength="100" placeholder="What are you looking for?">
        <button type="submit">Search</button>
      </form>
    </div>
    <div class="col-lg-5">
      <div class="bag-scene" aria-hidden="true">
        <div class="scene-label">SMALL FINDS<br>BIG POSSIBILITIES</div>
        <div class="shopping-bag">
          <div class="bag-handle"></div>
          <span class="bag-brand">ShopNow<span>.</span></span>
        </div>
        <span class="scene-spark spark-one">+</span>
        <span class="scene-spark spark-two">+</span>
        <span class="scene-tag">Made for your everyday</span>
      </div>
    </div>
  </section>
  <% if (categories.length) { %>
    <section class="category-section" aria-labelledby="category-title">
      <div class="section-heading"><h2 id="category-title">Find your kind of everyday.</h2><span>Shop by category</span></div>
      <div class="category-links">
        <% categories.forEach(category => { %>
          <a class="category-link" href="<%= categoryUrl(category.slug) %>"><%= category.name %><span aria-hidden="true">&nearr;</span></a>
        <% }); %>
      </div>
    </section>
  <% } %>
  <section class="arrivals-section" aria-labelledby="arrivals-title">
    <div class="section-heading"><div><p class="eyebrow">Fresh on the shelf</p><h2 id="arrivals-title">New arrivals</h2></div><a class="text-link" href="/products">View all products &rarr;</a></div>
    <% if (products.length) { %>
      <div class="product-grid home-grid">
        <% products.forEach(product => { %><%- include("partials/productCard", { product }) %><% }); %>
      </div>
    <% } else { %>
      <div class="empty-state"><h3>Our shelves are getting ready.</h3><p>Visit again soon to discover new products.</p></div>
    <% } %>
  </section>
</main>

<%- include("partials/footer") %>
