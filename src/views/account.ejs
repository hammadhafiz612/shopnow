<%- include("partials/header") %>

<main id="main-content" class="container account-page">
  <div class="page-heading"><p class="eyebrow">Your ShopNow account</p><h1>Hello, <%= currentUser.full_name %>.</h1><p>Good to have you here.</p></div>
  <div class="account-layout">
    <section class="account-card" aria-labelledby="profile-title">
      <h2 id="profile-title">Account details</h2>
      <dl class="account-details"><div><dt>Full name</dt><dd><%= currentUser.full_name %></dd></div><div><dt>Email address</dt><dd><%= currentUser.email %></dd></div><div><dt>Account type</dt><dd><%= currentUser.role === 'admin' ? 'Administrator' : 'Customer' %></dd></div></dl>
      <a class="text-link" href="/forgot-password">Reset your password &rarr;</a>
    </section>
    <section class="account-welcome" aria-labelledby="browse-title"><p class="eyebrow">Something for your everyday</p><h2 id="browse-title">Find your next favourite.</h2><p>Explore useful essentials and fresh finds from the catalogue.</p><a class="shop-button" href="/products">Browse products &rarr;</a>
      <div class="account-shopping-links"><a class="text-link" href="/cart">Your cart &rarr;</a><a class="text-link" href="/wishlist">Your wishlist &rarr;</a></div>
      <div class="account-shopping-links"><a class="text-link" href="/orders">Your orders &rarr;</a><a class="text-link" href="/addresses">Delivery addresses &rarr;</a></div>
      <% if (currentUser.role === 'admin') { %><a class="back-link" href="/admin">Open store overview &rarr;</a><% } %>
    </section>
  </div>
</main>

<%- include("partials/footer") %>
