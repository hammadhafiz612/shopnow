<%- include("../partials/header") %>
<main id="main-content" class="container shopping-page">
  <div class="page-heading"><p class="eyebrow">Order details &middot; <%= order.placedLabel %></p><h1 class="order-number"><%= order.orderNumber %></h1><div class="order-badges"><span class="status-pill">Order: <%= order.orderStatus %></span><span class="status-pill <%= order.paymentStatus === 'paid' ? 'status-success' : '' %>">Payment: <%= order.paymentStatus %></span></div></div>
  <div class="cart-layout checkout-layout"><div class="commerce-stack">
    <section class="commerce-card"><h2>Your items</h2><%- include("../partials/orderLines", { items: order.items }) %><p class="field-hint">Names, quantities and prices are saved from the time of your order.</p></section>
    <section class="commerce-card"><h2>Delivery details</h2><%- include("../partials/deliveryAddress", { address: order.deliveryAddress }) %><p class="field-hint">This address is saved with your order.</p></section>
    <% if (order.payments.length) { %><section class="commerce-card"><h2>Demo payment history</h2><ul class="payment-history"><% order.payments.forEach(payment => { %><li><div><span class="status-pill <%= payment.status === 'succeeded' ? 'status-success' : '' %>"><%= payment.status %></span><strong><%= payment.amountLabel %></strong></div><code><%= payment.reference %></code><% if (payment.failureReason) { %><p><%= payment.failureReason %></p><% } %></li><% }); %></ul></section><% } %>
  </div><aside class="cart-summary checkout-summary" aria-labelledby="order-summary-title"><h2 id="order-summary-title">Order summary</h2><%- include("../partials/orderTotals", { summary: order }) %>
    <% if (order.canPay) { %><div class="demo-note"><strong>Simulated payment</strong><span>No real charge. Do not enter card details.</span></div><form action="/orders/<%= order.id %>/pay" method="post" class="commerce-form demo-payment-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="paymentKey" value="<%= paymentKey %>"><div><label for="payment-outcome">Choose a demo result</label><select id="payment-outcome" name="outcome"><option value="success">Successful payment</option><option value="failure">Failed payment</option></select></div><button class="shop-button" type="submit">Run demo payment &rarr;</button></form><p class="field-hint">A failed attempt keeps this order pending and its stock reserved. Retry with a new attempt, or cancel below.</p><% } else if (order.orderStatus === 'cancelled') { %><p class="summary-warning">This order was cancelled. Stock and any coupon reservation were restored. Any earlier demo payment stays in your payment history.</p><% } else if (order.paymentStatus === 'paid') { %><p class="payment-complete">Demo payment complete. Your order is <%= order.orderStatus %>.</p><% } %>
    <% if (order.canCancel) { %><form action="/orders/<%= order.id %>/cancel" method="post" class="cancel-order-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="remove-button" type="submit">Cancel unpaid order</button><p class="field-hint">This releases its stock and any coupon reservation. You can place a new order from your cart.</p></form><% } %>
  </aside></div>
  <div class="account-shopping-links"><a class="text-link" href="/orders">&larr; Your orders</a><a class="text-link" href="/products">Continue shopping &rarr;</a></div>
</main>
<%- include("../partials/footer") %>
