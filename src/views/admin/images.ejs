<%- include("../partials/header") %>
<main id="main-content" class="container admin-page"><%- include("partials/nav") %>
  <div class="page-heading"><p class="eyebrow">Product images &middot; <%= product.sku %></p><h1><%= product.name %></h1><p><%= images.length %> of <%= maximum %> images. Choose a primary photo for the product card and detail page.</p></div>
  <section class="commerce-card image-upload-card"><h2>Add a product image</h2><form action="/admin/products/<%= product.id %>/images" method="post" enctype="multipart/form-data" class="commerce-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div><label for="product-image-file">Image *</label><input id="product-image-file" type="file" name="image" accept="image/jpeg,image/png,image/webp" required<% if (images.length >= maximum) { %> disabled<% } %>><p class="field-hint">JPEG, PNG or WebP; up to 5 MiB. Still images only, up to 16 million pixels and 6000 pixels per side. Large images are resized to fit 1600 pixels.</p></div>
    <div class="form-columns"><div><label for="upload-alt">Image description</label><input id="upload-alt" name="alt_text" maxlength="200" placeholder="A short description of the product photo"></div><div><label for="upload-primary">Use as primary image?</label><select id="upload-primary" name="make_primary"><option value="0">Keep the current primary image</option><option value="1">Make this the primary image</option></select><p class="field-hint">The first image automatically becomes primary.</p></div></div>
    <button class="shop-button" type="submit"<% if (images.length >= maximum) { %> disabled<% } %>>Upload image &rarr;</button>
  </form></section>
  <% if (images.length) { %><div class="admin-image-grid"><% images.forEach(image => { %><article class="commerce-card admin-image-card"><div class="admin-image-preview"><img src="<%= image.src %>" alt="<%= image.alt || product.name %>" width="360" height="270"></div><div class="image-card-heading"><span class="status-pill"><%= image.isPrimary ? 'Primary image' : 'Gallery image' %></span><a class="text-link" href="<%= image.src %>" target="_blank" rel="noopener">View photo &nearr;</a></div>
    <form action="/admin/products/<%= product.id %>/images/<%= image.id %>/alt" method="post" class="commerce-form image-alt-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><label for="image-alt-<%= image.id %>">Image description</label><input id="image-alt-<%= image.id %>" name="alt_text" maxlength="200" value="<%= image.alt %>"></div><button class="small-action" type="submit">Save description</button></form>
    <div class="address-actions"><% if (!image.isPrimary) { %><form action="/admin/products/<%= product.id %>/images/<%= image.id %>/primary" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-action" type="submit">Make primary</button></form><% } %><form action="/admin/products/<%= product.id %>/images/<%= image.id %>/remove" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="remove-button" type="submit" aria-label="Remove image <%= image.id %>">Remove image</button></form></div>
  </article><% }); %></div><% } else { %><section class="empty-state image-empty-state"><h2>No product photos yet.</h2><p>The storefront uses its placeholder until you upload an image.</p></section><% } %>
  <div class="account-shopping-links"><a class="text-link" href="/admin/products/<%= product.id %>/edit">&larr; Edit product</a><a class="text-link" href="/products/<%= product.id %>">View storefront product &nearr;</a></div>
</main>
<%- include("../partials/footer") %>
