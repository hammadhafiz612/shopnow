<%- include("../partials/header") %>
<main id="main-content" class="container admin-page"><%- include("partials/nav") %>
  <div class="page-heading"><p class="eyebrow">Store administration</p><h1>Customer orders.</h1><p><%= listing.total %> matching orders. Open an order to review payment and delivery details.</p></div>
  <form action="/admin/orders" method="get" class="commerce-form admin-filters"><div><label for="order-search">Search</label><input id="order-search" name="q" maxlength="100" placeholder="Order number, customer or email" value="<%= filters.q %>"></div><div><label for="order-filter">Order status</label><select id="order-filter" name="status"><option value="">All statuses</option><% statuses.forEach(status => { %><option value="<%= status %>"<% if (filters.status === status) { %> selected<% } %>><%= status %></option><% }); %></select></div><div><label for="payment-filter">Payment status</label><select id="payment-filter" name="payment"><option value="">All payments</option><% paymentStatuses.forEach(status => { %><option value="<%= status %>"<% if (filters.payment === status) { %> selected<% } %>><%= status %></option><% }); %></select></div><div class="admin-filter-actions"><button class="shop-button" type="submit">Apply filters</button><a class="text-link" href="/admin/orders">Reset</a></div></form>
  <% if (listing.items.length) { %><div class="admin-table-wrap"><%- include("partials/orderRows", { items: listing.items }) %></div><%- include("partials/pager") %><% } else { %><section class="empty-state"><h2>No matching orders.</h2><p>Change the filters or return after customers have placed orders.</p></section><% } %>
</main>
<%- include("../partials/footer") %>
