<%- include("../partials/header") %>

<main id="main-content" class="container product-page">
  <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href="/products">Products</a><span aria-hidden="true">/</span><a href="<%= categoryUrl %>"><%= product.category.name %></a><span aria-hidden="true">/</span><span aria-current="page"><%= product.name %></span></nav>
  <div class="product-detail-layout">
    <section class="product-gallery" aria-label="Product images">
      <div class="main-product-image"><img src="<%= product.primaryImage.src %>" alt="<%= product.primaryImage.alt %>" width="640" height="560"></div>
      <% if (product.images.length > 1) { %><div class="additional-images">
        <% product.images.slice(1).forEach(image => { %><img src="<%= image.src %>" alt="<%= image.alt %>" width="240" height="200" loading="lazy"><% }); %>
      </div><% } %>
    </section>
    <section class="product-information" aria-labelledby="product-title">
      <a class="eyebrow category-eyebrow" href="<%= categoryUrl %>"><%= product.category.name %></a>
      <h1 id="product-title"><%= product.name %></h1>
      <p class="detail-price"><%= product.priceLabel %></p>
      <p class="availability <%= product.inStock ? '' : 'out-of-stock' %>"><span aria-hidden="true"></span><%= product.inStock ? `In stock · ${product.stock_quantity} available` : 'Currently out of stock' %></p>
      <%- include("../partials/productActions", { product, compact: false }) %>
      <div class="product-description"><h2>About this product</h2><p><%= product.description %></p></div>
      <dl class="product-facts"><div><dt>Product code</dt><dd><%= product.sku %></dd></div><div><dt>Category</dt><dd><%= product.category.name %></dd></div></dl>
      <a class="text-link" href="<%= categoryUrl %>">Explore this category &rarr;</a>
      <a class="back-link" href="/products">&larr; Back to all products</a>
    </section>
  </div>
</main>

<%- include("../partials/footer") %>
