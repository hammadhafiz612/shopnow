<table class="admin-table"><thead><tr><th scope="col">Order</th><th scope="col">Customer</th><th scope="col">Total</th><th scope="col">Status</th><th scope="col">Payment</th></tr></thead><tbody>
<% items.forEach(order => { %><tr><td data-label="Order"><div><a class="admin-record-link" href="/admin/orders/<%= order.id %>"><%= order.orderNumber %></a><span class="admin-cell-note"><%= order.placedLabel %></span></div></td><td data-label="Customer"><div><strong><%= order.customer.full_name %></strong><span class="admin-cell-note"><%= order.customer.email %></span></div></td><td data-label="Total"><strong><%= order.totalLabel %></strong></td><td data-label="Status"><span class="status-pill"><%= order.orderStatus %></span></td><td data-label="Payment"><span class="status-pill <%= order.paymentStatus === 'paid' ? 'status-success' : '' %>"><%= order.paymentStatus %></span></td></tr><% }); %>
</tbody></table>
