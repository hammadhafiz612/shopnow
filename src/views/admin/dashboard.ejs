<%- include("../partials/header") %>

<main id="main-content" class="container admin-page">
  <%- include("partials/nav") %>
  <div class="page-heading"><p class="eyebrow">Store administration</p><h1>Your store, at a glance.</h1><p>Welcome, <%= currentUser.full_name %>. Here is the latest overview.</p></div>
  <section class="admin-stats" aria-label="Store totals">
    <% [['Products', stats.products], ['Categories', stats.categories], ['Customers', stats.customers], ['Orders', stats.orders]].forEach(stat => { %><article class="stat-card"><h2><%= stat[0] %></h2><p><%= stat[1] %></p></article><% }); %>
    <article class="stat-card sales-stat"><h2>Delivered sales</h2><p><%= stats.totalSalesLabel %></p><span>Paid, delivered orders only.</span></article>
  </section>
  <section class="admin-dashboard-section"><div class="section-heading"><h2>Recent orders</h2><a class="text-link" href="/admin/orders">View all orders &rarr;</a></div><% if (stats.recentOrders.length) { %><div class="admin-table-wrap"><%- include("partials/orderRows", { items: stats.recentOrders }) %></div><% } else { %><div class="empty-state"><h3>No orders yet.</h3><p>Customer orders will appear here.</p></div><% } %></section>
  <section class="admin-dashboard-section"><div class="section-heading"><h2>Low stock</h2><a class="text-link" href="/admin/inventory?low=1&state=active">Open inventory &rarr;</a></div><p class="field-hint">Active storefront products with <%= stats.lowStockThreshold %> units or fewer; up to 10 shown.</p><% if (stats.lowStock.length) { %><div class="admin-low-stock"><% stats.lowStock.forEach(product => { %><article class="commerce-card"><div><h3><%= product.name %></h3><p><%= product.sku %></p></div><strong><%= product.stock_quantity %> left</strong><a class="text-link" href="/admin/inventory?q=<%= encodeURIComponent(product.sku) %>">Set stock &rarr;</a></article><% }); %></div><% } else { %><div class="empty-state"><h3>Stock looks healthy.</h3><p>No active storefront products are at the low-stock threshold.</p></div><% } %></section>
</main>

<%- include("../partials/footer") %>
