{
  "name": "shopnow",
  "version": "0.2.0",
  "private": true,
  "description": "ShopNow Step 2: ERD models, database migrations and sample catalogue data.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:check": "node scripts/check-database.js",
    "check": "node scripts/check-source.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:summary": "node scripts/database-summary.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "dotenv": "^17.0.0",
    "ejs": "^3.1.10",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.0.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
