<div><label for="coupon-code">Coupon code *</label><input id="coupon-code" name="code" maxlength="50" required value="<%= values.code || '' %>"><p class="field-hint">Letters, numbers, underscores and hyphens. A coupon with order history keeps its code.</p></div>
<div class="form-columns"><div><label for="discount-type">Discount type *</label><select id="discount-type" name="discount_type"><option value="percentage"<% if (values.discount_type === 'percentage') { %> selected<% } %>>Percentage (%)</option><option value="fixed"<% if (values.discount_type === 'fixed') { %> selected<% } %>>Fixed amount (PKR)</option></select></div><div><label for="discount-value">Discount value *</label><input id="discount-value" name="discount_value" type="number" min="0.01" max="9999999999.99" step="0.01" required value="<%= values.discount_value || '' %>"><p class="field-hint">Percentage discounts must be between 0.01 and 100.</p></div></div>
<div class="form-columns"><div><label for="minimum-subtotal">Minimum subtotal (PKR) *</label><input id="minimum-subtotal" name="min_order_amount" type="number" min="0" max="9999999999.99" step="0.01" required value="<%= values.min_order_amount || '0.00' %>"></div><div><label for="coupon-expiry">Expires at (UTC)</label><input id="coupon-expiry" name="expires_at" type="datetime-local" value="<%= values.expires_at || '' %>"><p class="field-hint">Leave blank for no expiry. The time is in UTC.</p></div></div>
<div class="form-columns"><div><label for="global-limit">Global usage limit</label><input id="global-limit" name="global_usage_limit" type="number" min="1" max="2147483647" step="1" value="<%= values.global_usage_limit || '' %>"></div><div><label for="customer-limit">Per-customer usage limit</label><input id="customer-limit" name="per_user_usage_limit" type="number" min="1" max="2147483647" step="1" value="<%= values.per_user_usage_limit || '' %>"></div></div>
<p class="field-hint">Blank limits mean unlimited. Active uses include pending orders. Cancellation releases usage; existing order totals keep their original discount.</p>
