<%- include("../partials/header") %>
<main id="main-content" class="container admin-page">
  <%- include("partials/nav") %>
  <div class="page-heading"><p class="eyebrow">Store administration</p><h1><%= recordId ? 'Edit' : 'New' %> <%= singular %>.</h1><p>Fields marked with * are required.</p></div>
  <section class="commerce-card admin-form-card"><%- include("../partials/formMessages", { errors, message: '' }) %>
    <form action="/admin/<%= resource %><%= recordId ? '/' + recordId + '/update' : '' %>" method="post" class="commerce-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= values.revision || '' %>">
      <%- include("fields/" + singular) %>
      <div><label for="is-active">Availability *</label><select id="is-active" name="is_active"><option value="1"<% if (values.is_active) { %> selected<% } %>>Active</option><option value="0"<% if (!values.is_active) { %> selected<% } %>>Inactive</option></select><p class="field-hint">Deactivate records to stop new use while preserving order history.</p></div>
      <div class="address-actions"><button class="shop-button" type="submit">Save <%= singular %> &rarr;</button><a class="text-link" href="/admin/<%= resource %>">Back to list</a><% if (recordId) { %><a class="text-link" href="/admin/<%= resource %>/<%= recordId %>/edit">Reload saved details</a><% } %></div>
    </form>
  </section>
</main>
<%- include("../partials/footer") %>
