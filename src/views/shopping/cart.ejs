<%- include("../partials/header") %>

<main id="main-content" class="container shopping-page">
  <div class="page-heading"><p class="eyebrow">Your everyday finds</p><h1>Your shopping cart.</h1><p><%= cart.lineCount %> <%= cart.lineCount === 1 ? 'product' : 'products' %>, <%= cart.itemCount %> <%= cart.itemCount === 1 ? 'item' : 'items' %> in your cart.</p></div>
  <% if (!cart.items.length) { %>
    <section class="empty-state"><p class="eyebrow">Room for a good find</p><h2>Your cart is empty.</h2><p>Explore the catalogue and add something for your day.</p><a class="shop-button" href="/products">Browse products &rarr;</a></section>
  <% } else { %>
    <div class="cart-layout">
      <section class="cart-list" aria-label="Cart products">
        <% cart.items.forEach(item => { const product = item.product; %>
          <article class="cart-line">
            <div class="cart-line-image"><img src="<%= product.primaryImage.src %>" alt="<%= product.primaryImage.alt %>" width="100" height="100"></div>
            <div class="cart-line-main">
              <div class="cart-line-heading"><div><p class="product-category"><%= product.category ? product.category.name : 'Unavailable' %></p><h2><% if (product.available) { %><a href="/products/<%= item.productId %>"><%= product.name %></a><% } else { %><%= product.name %><% } %></h2><p class="cart-unit-price"><%= product.priceLabel %> each</p></div><strong class="cart-line-total"><%= item.lineTotalLabel %></strong></div>
              <% if (item.warning) { %><p class="cart-warning" role="status"><%= item.warning %></p><% } %>
              <div class="cart-line-controls">
                <form action="/cart/items/<%= item.productId %>/update" method="post" class="cart-quantity-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/cart">
                  <label for="quantity-<%= item.productId %>">Quantity</label><input id="quantity-<%= item.productId %>" name="quantity" type="number" min="1" max="<%= Math.max(item.maximumQuantity, 1) %>" value="<%= item.quantity %>" required<% if (!item.maximumQuantity) { %> disabled<% } %>>
                  <button class="small-action" type="submit"<% if (!item.maximumQuantity) { %> disabled<% } %>>Update</button>
                </form>
                <form action="/cart/items/<%= item.productId %>/remove" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/cart"><button class="remove-button" type="submit" aria-label="Remove <%= product.name %> from cart">Remove</button></form>
              </div>
            </div>
          </article>
        <% }); %>
        <div class="cart-list-footer"><a class="text-link" href="/products">&larr; Continue shopping</a><form action="/cart/clear" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/cart"><button class="remove-button" type="submit">Clear cart</button></form></div>
      </section>
      <aside class="cart-summary" aria-labelledby="summary-title">
        <h2 id="summary-title">Cart summary</h2><div class="summary-row"><span>Items</span><strong><%= cart.itemCount %></strong></div>
        <div class="summary-row"><span>Subtotal</span><strong><%= cart.subtotalLabel %></strong></div>
        <div class="summary-row"><span>Discount</span><strong><%= cart.discountLabel %></strong></div>
        <div class="cart-subtotal"><span>Total</span><strong><%= cart.totalLabel %></strong></div>
        <p>Prices reflect current product prices. Apply a coupon at checkout to review your final discount and total.</p>
        <% if (cart.hasWarnings) { %><p class="summary-warning">Some items need attention. Review the stock warnings and update your cart.</p><% } %>
        <% if (!cart.hasWarnings) { %><a class="shop-button" href="/checkout"><%= currentUser ? 'Continue to checkout' : 'Sign in to checkout' %> &rarr;</a><% } %>
        <% if (!currentUser) { %><p class="guest-cart-note">Your guest cart is temporary. Signing in saves it to your account.</p><% } else { %><p class="saved-cart-note">Your cart is saved to your account.</p><% } %>
      </aside>
    </div>
  <% } %>
</main>

<%- include("../partials/footer") %>
