<%- include("../partials/header") %>
<main id="main-content" class="container shopping-page">
  <div class="page-heading"><p class="eyebrow">A place for your everyday finds</p><h1><%= id ? 'Edit delivery address.' : 'Add a delivery address.' %></h1><p>Fields marked with * are required.</p></div>
  <section class="commerce-card address-form-card">
    <%- include("../partials/formMessages", { errors, message: '' }) %>
    <form action="<%= id ? '/addresses/' + id + '/update' : '/addresses' %>" method="post" class="commerce-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="next" value="<%= next %>">
      <div class="form-columns"><div><label for="address-label">Label</label><input id="address-label" name="label" maxlength="50" placeholder="Home or office" value="<%= values.label || '' %>"></div><div><label for="recipient-name">Recipient name *</label><input id="recipient-name" name="recipient_name" autocomplete="shipping name" maxlength="100" required value="<%= values.recipient_name || '' %>"></div></div>
      <div><label for="address-phone">Phone number *</label><input id="address-phone" name="phone" type="tel" autocomplete="shipping tel" maxlength="30" required value="<%= values.phone || '' %>"></div>
      <div><label for="address-line1">Address line 1 *</label><input id="address-line1" name="line1" autocomplete="shipping address-line1" maxlength="200" required value="<%= values.line1 || '' %>"></div>
      <div><label for="address-line2">Address line 2</label><input id="address-line2" name="line2" autocomplete="shipping address-line2" maxlength="200" value="<%= values.line2 || '' %>"></div>
      <div class="form-columns"><div><label for="address-city">City *</label><input id="address-city" name="city" autocomplete="shipping address-level2" maxlength="100" required value="<%= values.city || '' %>"></div><div><label for="address-state">State / province</label><input id="address-state" name="state" autocomplete="shipping address-level1" maxlength="100" value="<%= values.state || '' %>"></div></div>
      <div class="form-columns"><div><label for="address-postal">Postal code</label><input id="address-postal" name="postal_code" autocomplete="shipping postal-code" maxlength="20" value="<%= values.postal_code || '' %>"></div><div><label for="address-country">Country code *</label><input id="address-country" name="country_code" autocomplete="shipping country" maxlength="2" minlength="2" required aria-describedby="country-help" value="<%= values.country_code || '' %>"><p id="country-help" class="field-hint">Two letters, for example PK for Pakistan.</p></div></div>
      <label class="checkbox-label" for="address-default"><input id="address-default" name="is_default" type="checkbox" value="1"<% if (values.is_default) { %> checked<% } %>> Use as my default address</label>
      <p class="field-hint">Your first address becomes the default. To switch, choose another address as default.</p>
      <div class="address-actions"><button class="shop-button" type="submit">Save address &rarr;</button><a class="text-link" href="<%= next === 'checkout' ? '/checkout' : '/addresses' %>">Cancel</a></div>
    </form>
  </section>
</main>
<%- include("../partials/footer") %>
