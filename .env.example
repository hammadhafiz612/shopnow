# Copy this file to .env and enter your local PostgreSQL password.
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=shopnow_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgresql_password

# Run npm.cmd run auth:setup to generate SESSION_SECRET inside your existing .env.
SESSION_SECRET=
APP_URL=http://localhost:3000
# Set only when running behind your own single reverse proxy.
TRUST_PROXY=0

# Optional for registration/login; required to send password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Registration/order notifications: smtp sends mail; preview saves private local .eml files.
# Password reset always uses SMTP and never appears in the notification preview screen.
MAIL_MODE=smtp
# Set 0 only when running mail:process yourself; the web server normally processes the queue.
MAIL_WORKER=1
