<%- include("../partials/header") %>
<main id="main-content" class="container admin-page"><%- include("partials/nav") %>
  <div class="page-heading"><p class="eyebrow">Customer order &middot; <%= order.placedLabel %></p><h1 class="order-number"><%= order.orderNumber %></h1><div class="order-badges"><span class="status-pill">Order: <%= order.orderStatus %></span><span class="status-pill <%= order.paymentStatus === 'paid' ? 'status-success' : '' %>">Payment: <%= order.paymentStatus %></span></div></div>
  <%- include("../partials/formMessages", { errors, message: '' }) %>
  <div class="cart-layout checkout-layout"><div class="commerce-stack"><section class="commerce-card"><h2>Customer</h2><p class="admin-customer"><strong><%= order.customer.full_name %></strong><span><%= order.customer.email %></span></p></section><section class="commerce-card"><h2>Ordered items</h2><%- include("../partials/orderLines", { items: order.items }) %></section><section class="commerce-card"><h2>Delivery snapshot</h2><%- include("../partials/deliveryAddress", { address: order.deliveryAddress }) %></section>
  <% if (order.payments.length) { %><section class="commerce-card"><h2>Demo payment history</h2><ul class="payment-history"><% order.payments.forEach(payment => { %><li><div><span class="status-pill <%= payment.status === 'succeeded' ? 'status-success' : '' %>"><%= payment.status %></span><strong><%= payment.amountLabel %></strong></div><code><%= payment.reference %></code><% if (payment.failureReason) { %><p><%= payment.failureReason %></p><% } %></li><% }); %></ul></section><% } %></div>
  <aside class="cart-summary checkout-summary"><h2>Order summary</h2><%- include("../partials/orderTotals", { summary: order }) %>
    <% if (order.allowedStatuses.length) { %><form action="/admin/orders/<%= order.id %>/status" method="post" class="commerce-form admin-status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedStatus" value="<%= order.orderStatus %>"><div><label for="new-status">Order status</label><select id="new-status" name="status"><option value="<%= order.orderStatus %>"><%= order.orderStatus %> (current)</option><% order.allowedStatuses.forEach(status => { %><option value="<%= status %>"><%= status %></option><% }); %></select></div><button class="shop-button" type="submit">Save status &rarr;</button></form><% } else { %><p class="field-hint">This order has no further eligible status changes.</p><% } %>
    <p class="field-hint">Only paid orders can ship. Orders can be cancelled before shipping; cancellation restores stock and coupon usage once.</p><div class="demo-note"><strong>Demo payment records stay in history.</strong><span>Cancelling a paid demo order preserves its payment status. Cancelled orders are excluded from delivered sales. No real payment or refund is processed.</span></div>
  </aside></div><a class="back-link" href="/admin/orders">&larr; All customer orders</a>
</main>
<%- include("../partials/footer") %>
