<%- include("../partials/header") %>
<main id="main-content" class="container admin-page">
  <%- include("partials/nav") %>
  <div class="section-heading"><div class="page-heading"><p class="eyebrow">Store administration</p><h1><%= resource[0].toUpperCase() + resource.slice(1) %>.</h1><p><%= listing.total %> matching records<%= resource === 'inventory' ? '. Low stock: ' + lowStockThreshold + ' units or fewer' : '' %>.</p></div><% if (resource !== 'inventory') { %><a class="shop-button" href="/admin/<%= resource %>/new">Add <%= resource === 'categories' ? 'category' : resource === 'products' ? 'product' : 'coupon' %> +</a><% } %></div>
  <form action="/admin/<%= resource %>" method="get" class="commerce-form admin-filters"><div><label for="admin-search">Search</label><input id="admin-search" name="q" maxlength="100" value="<%= filters.q %>" placeholder="<%= resource === 'coupons' ? 'Coupon code' : resource === 'categories' ? 'Name or slug' : 'Name or SKU' %>"></div><div><label for="admin-state">Availability</label><select id="admin-state" name="state"><% ['all','active','inactive'].forEach(state => { %><option value="<%= state %>"<% if (filters.state === state) { %> selected<% } %>><%= state[0].toUpperCase() + state.slice(1) %></option><% }); %></select></div>
    <% if (['products','inventory'].includes(resource)) { %><div><label for="admin-category">Category</label><select id="admin-category" name="category"><option value="">All categories</option><% categories.forEach(category => { %><option value="<%= category.id %>"<% if (String(category.id) === filters.category) { %> selected<% } %>><%= category.name %></option><% }); %></select></div><div><label for="admin-stock">Stock</label><select id="admin-stock" name="low"><option value="">All quantities</option><option value="1"<% if (filters.low) { %> selected<% } %>>Low stock (&le; <%= lowStockThreshold %>)</option></select></div><% } %>
    <div class="admin-filter-actions"><button class="shop-button" type="submit">Apply filters</button><a class="text-link" href="/admin/<%= resource %>">Reset</a></div>
  </form>
  <% if (!listing.items.length) { %><section class="empty-state"><h2>No matching records.</h2><p>Change the filters or add a record to get started.</p></section><% } else { %>
  <div class="admin-table-wrap"><table class="admin-table"><thead><tr>
    <% (resource === 'categories' ? ['Category','Slug','Products','Availability','Actions'] : resource === 'coupons' ? ['Code','Discount','Minimum','Expiry (UTC)','Active uses','Availability','Actions'] : resource === 'inventory' ? ['Product','Category','Available stock','Set quantity'] : ['Product','Category','Price','Stock','Availability','Actions']).forEach(label => { %><th scope="col"><%= label %></th><% }); %>
  </tr></thead><tbody><% listing.items.forEach(item => { %><tr>
    <% if (resource === 'categories') { %>
      <td data-label="Category"><strong><%= item.name %></strong></td><td data-label="Slug"><code><%= item.slug %></code></td><td data-label="Products"><%= item.productCount %></td><td data-label="Availability"><span class="status-pill"><%= item.is_active ? 'Active' : 'Inactive' %></span></td>
    <% } else if (resource === 'coupons') { %>
      <td data-label="Code"><strong><%= item.code %></strong></td><td data-label="Discount"><%= item.discount_type === 'percentage' ? item.discount_value + '%' : 'PKR ' + item.discount_value %></td><td data-label="Minimum">PKR <%= item.min_order_amount %></td><td data-label="Expiry (UTC)"><%= item.expires_at ? item.expires_at.toISOString().slice(0,16).replace('T',' ') : 'No expiry' %></td><td data-label="Active uses"><%= item.activeUses %><%= item.global_usage_limit ? ' / ' + item.global_usage_limit : '' %></td><td data-label="Availability"><span class="status-pill"><%= !item.is_active ? 'Inactive' : item.expires_at && item.expires_at.getTime() <= Date.now() ? 'Expired' : 'Active' %></span></td>
    <% } else { %>
      <td data-label="Product"><div><strong><%= item.name %></strong><span class="admin-cell-note"><%= item.sku %></span></div></td><td data-label="Category"><div><%= item.category.name %><% if (!item.category.is_active) { %><span class="admin-cell-note">Category inactive</span><% } %></div></td>
      <% if (resource === 'products') { %><td data-label="Price"><strong><%= item.priceLabel %></strong></td><% } %>
      <td data-label="<%= resource === 'inventory' ? 'Available stock' : 'Stock' %>"><span class="<%= item.stock_quantity <= lowStockThreshold ? 'low-stock-number' : '' %>"><%= item.stock_quantity %></span></td>
      <% if (resource === 'products') { %><td data-label="Availability"><span class="status-pill"><%= item.is_active ? item.storefrontActive ? 'Active' : 'Category hidden' : 'Inactive' %></span></td><% } %>
    <% } %>
    <% if (resource === 'inventory') { %><td data-label="Set quantity"><form action="/admin/inventory/<%= item.id %>" method="post" class="inventory-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedStock" value="<%= item.stock_quantity %>"><label class="visually-hidden" for="stock-<%= item.id %>">New stock for <%= item.name %></label><input id="stock-<%= item.id %>" name="stock_quantity" type="number" min="0" max="2147483647" step="1" required value="<%= item.stock_quantity %>"><button class="small-action" type="submit">Set stock</button></form></td><% } else { %><td data-label="Actions"><div class="mail-row-actions"><a class="text-link" href="/admin/<%= resource %>/<%= item.id %>/edit">Edit</a><% if (resource === 'products') { %><a class="text-link" href="/admin/products/<%= item.id %>/images">Images</a><% } %></div></td><% } %>
  </tr><% }); %></tbody></table></div><%- include("partials/pager") %>
  <% } %>
  <% if (resource === 'inventory') { %><p class="field-hint">These are available units. Orders already placed have deducted their quantities. If stock changes while you are editing, reload before setting a new quantity.</p><% } %>
</main>
<%- include("../partials/footer") %>
