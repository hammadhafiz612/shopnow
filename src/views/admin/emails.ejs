<%- include("../partials/header") %>
<main id="main-content" class="container admin-page"><%- include("partials/nav") %>
  <div class="page-heading"><p class="eyebrow">Store communications</p><h1>Email notifications.</h1><p>Registration, order confirmations and order updates.</p></div>
  <div class="admin-info-note mail-mode-note"><strong><%= listing.mode === 'preview' ? 'Local preview mode' : 'SMTP delivery mode' %></strong><p><%= listing.mode === 'preview' ? 'Messages are saved locally for review. They are not delivered to recipients.' : listing.ready ? 'Messages are delivered using your configured email server.' : 'SMTP is not configured. Notifications stay queued until email settings are ready.' %></p><span><%= listing.automatic ? 'The background worker checks for ready messages every 10 seconds.' : 'Automatic processing is off. Run npm.cmd run mail:process from the project terminal.' %></span></div>
  <form action="/admin/emails" method="get" class="commerce-form admin-filters"><div><label for="email-status">Delivery status</label><select id="email-status" name="status"><option value="">All statuses</option><% statuses.forEach(value => { %><option value="<%= value %>"<% if (value === status) { %> selected<% } %>><%= value %></option><% }); %></select></div><div class="admin-filter-actions"><button class="shop-button" type="submit">Apply filter</button><a class="text-link" href="/admin/emails">Reset</a></div></form>
  <% if (listing.items.length) { %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th scope="col">Message</th><th scope="col">Recipient</th><th scope="col">Delivery</th><th scope="col">Attempts</th><th scope="col">Actions</th></tr></thead><tbody><% listing.items.forEach(item => { %><tr><td data-label="Message"><div><strong><%= item.subject %></strong><span class="admin-cell-note"><%= item.kind.replace(/_/g,' ') %> &middot; <%= item.created_at.toISOString().slice(0,16).replace('T',' ') %> UTC</span></div></td><td data-label="Recipient"><%= item.recipient %></td><td data-label="Delivery"><div><span class="status-pill <%= ['sent','previewed'].includes(item.status) ? 'status-success' : '' %>"><%= item.status %></span><% if (item.last_error) { %><span class="admin-cell-note"><%= item.last_error %></span><% } %><% if (item.status === 'failed') { %><span class="admin-cell-note"><%= item.next_attempt_at ? 'Automatic retry is scheduled.' : 'Automatic attempts stopped. Review settings and retry.' %></span><% } %></div></td><td data-label="Attempts"><%= item.attempts %></td><td data-label="Actions"><div class="mail-row-actions"><% if (item.status === 'previewed') { %><a class="text-link" href="/admin/emails/<%= item.id %>/preview">View preview</a><% } %><% if (item.order_id) { %><a class="text-link" href="/admin/orders/<%= item.order_id %>">View order</a><% } %><% if (item.status === 'failed') { %><form action="/admin/emails/<%= item.id %>/retry" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="small-action" type="submit">Retry email</button></form><% } %></div></td></tr><% }); %></tbody></table></div><%- include("partials/pager") %><% } else { %><section class="empty-state"><h2>No matching notifications.</h2><p>New registrations and order events will appear here.</p></section><% } %>
  <p class="field-hint">SMTP acceptance does not guarantee inbox delivery. A connection interruption after acceptance can produce a duplicate on retry. Password reset emails use their separate SMTP flow and never appear in these previews.</p>
</main>
<%- include("../partials/footer") %>
