<%- include("partials/header") %>

<main class="container hero">
  <section class="row align-items-center g-5" aria-labelledby="home-title">
    <div class="col-lg-7">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Storefront coming soon</p>
      <h1 id="home-title">Your next favourite find starts here.</h1>
      <p class="hero-copy">Everyday essentials. Unexpected favourites. We are getting ShopNow ready for you.</p>
      <div class="launch-card">
        <span class="launch-label">A fresh way to shop</span>
        <p>Discover more. Choose easily. Enjoy the little things.</p>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="bag-scene" aria-hidden="true">
        <div class="scene-label">GOOD FINDS<br>COMING YOUR WAY</div>
        <div class="shopping-bag">
          <div class="bag-handle"></div>
          <span class="bag-brand">ShopNow<span>.</span></span>
        </div>
        <span class="scene-spark spark-one">+</span>
        <span class="scene-spark spark-two">+</span>
        <span class="scene-tag">Made for your everyday</span>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
