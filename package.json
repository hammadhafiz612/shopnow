{
  "name": "shopnow",
  "version": "0.6.0",
  "private": true,
  "description": "ShopNow e-commerce with EJS, secure session API, admin management, images and queued email notifications.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:check": "node scripts/check-database.js",
    "check": "node scripts/check-source.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:summary": "node scripts/database-summary.js",
    "auth:setup": "node scripts/setup-session-secret.js",
    "admin:promote": "node scripts/promote-admin.js",
    "mail:process": "node scripts/process-mail.js",
    "smoke": "node scripts/smoke-check.js",
   
    "verify": "node scripts/verify-project.js",
    "backup": "node scripts/backup-project.js",
    "restore": "node scripts/restore-project.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.0",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "4.2.1",
    "dotenv": "^17.0.0",
    "ejs": "^3.1.10",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "joi": "18.2.9",
    "multer": "2.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.0.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0",
    "sharp": "0.35.5",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
